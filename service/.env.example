PRESSURE_DB=/var/lib/pressure_sensor/pressure.sqlite3
PRESSURE_PUBLIC_URL=https://timeonion.com/pressure_sensor
PRESSURE_WEB=/opt/pressure_sensor/current/service/web
# Generate with cryptography.fernet.Fernet.generate_key(); keep outside Git.
PRESSURE_KEY=
PRESSURE_MAIL_FROM=
PRESSURE_SMTP_HOST=
PRESSURE_SMTP_PORT=587
PRESSURE_SMTP_TLS=1
PRESSURE_SMTP_USER=
PRESSURE_SMTP_PASSWORD_FILE=/etc/pressure_sensor/smtp-password
